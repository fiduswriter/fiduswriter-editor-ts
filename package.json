{
    "name": "@fiduswriter/editor",
    "version": "0.1.3",
    "description": "Fidus Writer browser editor",
    "repository": {
        "type": "git",
        "url": "ssh://git@codeberg.org/fiduswriter/fiduswriter-editor-js.git"
    },
    "license": "AGPL-3.0",
    "author": "Johannes Wilm",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./*": "./dist/*.js"
    },
    "files": [
        "dist/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@fiduswriter/common": "^0.1.0",
        "@fiduswriter/document": "^0.2.16",
        "bibliojson": "^4.0.0",
        "citeproc-plus": "^1.0.2",
        "cropperjs": "^1.6.2",
        "diff": "^5.0.0",
        "diff-dom": "^5.2.1",
        "fastdom": "^1.0.11",
        "fast-deep-equal": "^3.1.3",
        "fast-xml-parser": "^4.5.0",
        "fix-utf8": "^2.0.1",
        "fwtoolkit": "^0.1.4",
        "jszip": "^3.10.1",
        "mathml-to-latex": "^1.4.3",
        "mathml2omml": "^0.5.0",
        "orderedmap": "^2.1.1",
        "pretty": "^2.0.0",
        "prosemirror-changeset": "^2.2.1",
        "prosemirror-collab": "^1.3.1",
        "prosemirror-commands": "^1.7.0",
        "prosemirror-dropcursor": "^1.8.1",
        "prosemirror-example-setup": "^1.2.3",
        "prosemirror-gapcursor": "^1.3.2",
        "prosemirror-history": "^1.3.2",
        "prosemirror-keymap": "^1.2.2",
        "prosemirror-menu": "^1.2.4",
        "prosemirror-model": "^1.25.0",
        "prosemirror-schema-basic": "^1.2.4",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.3",
        "prosemirror-suggestions": "^0.2.0",
        "prosemirror-tables": "^1.6.4",
        "prosemirror-transform": "^1.10.3",
        "prosemirror-view": "^1.38.1",
        "rfc6902": "^5.0.1",
        "sortablejs": "^1.15.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.0.1",
        "eslint": "^10.6.0",
        "globals": "^15.15.0",
        "prettier": "^3.5.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    }
}
