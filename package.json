{
  "name": "@fiduswriter/editor",
  "version": "0.1.37",
  "description": "Fidus Writer browser editor",
  "repository": {
    "type": "git",
    "url": "ssh://git@codeberg.org/fiduswriter/fiduswriter-editor-js.git"
  },
  "license": "AGPL-3.0",
  "author": "Johannes Wilm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state_plugins": {
      "types": "./dist/state_plugins/index.d.ts",
      "default": "./dist/state_plugins/index.js"
    },
    "./state_plugins/*": {
      "types": "./dist/state_plugins/*.d.ts",
      "default": "./dist/state_plugins/*.js"
    },
    "./menus": {
      "types": "./dist/menus/index.d.ts",
      "default": "./dist/menus/index.js"
    },
    "./menus/*": {
      "types": "./dist/menus/*.d.ts",
      "default": "./dist/menus/*.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs/index.d.ts",
      "default": "./dist/dialogs/index.js"
    },
    "./dialogs/*": {
      "types": "./dist/dialogs/*.d.ts",
      "default": "./dist/dialogs/*.js"
    },
    "./keymap": {
      "types": "./dist/keymap.d.ts",
      "default": "./dist/keymap.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js"
  },
  "dependencies": {
    "@fiduswriter/bibliography-manager": "^0.1.7",
    "@fiduswriter/common": "^0.1.5",
    "@fiduswriter/document": "^0.2.20",
    "@fiduswriter/image-manager": "^0.1.4",
    "bibliojson": "^4.0.0",
    "citeproc-plus": "^1.0.2",
    "cropperjs": "^1.6.2",
    "diff": "^5.0.0",
    "diff-dom": "^5.2.1",
    "fast-deep-equal": "^3.1.3",
    "fast-xml-parser": "^4.5.0",
    "fastdom": "^1.0.11",
    "fix-utf8": "^2.0.1",
    "fwtoolkit": "^0.1.9",
    "jszip": "^3.10.1",
    "mathml-to-latex": "^1.4.3",
    "mathml2omml": "^0.5.0",
    "orderedmap": "^2.1.1",
    "pretty": "^2.0.0",
    "prosemirror-changeset": "^2.2.1",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.0",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-menu": "^1.2.4",
    "prosemirror-model": "^1.25.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-suggestions": "^0.2.0",
    "prosemirror-tables": "^1.6.4",
    "prosemirror-transform": "^1.10.3",
    "prosemirror-view": "^1.38.1",
    "rfc6902": "^5.0.1",
    "sortablejs": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.10.6",
    "jest": "^30.4.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.11",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,css,md,json,html}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs}": [
      "eslint --fix"
    ]
  }
}
