{
    "name": "@fiduswriter/editor",
    "version": "0.2.39",
    "description": "Fidus Writer browser editor",
    "keywords": [
        "fiduswriter",
        "editor",
        "prosemirror",
        "collaborative-editing",
        "word-processor",
        "wysiwyg",
        "rich-text",
        "comments",
        "track-changes"
    ],
    "homepage": "https://fiduswriter.pages.fiduswriter.org/fiduswriter-editor-ts/",
    "bugs": {
        "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-editor-ts/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-editor-ts.git"
    },
    "license": "AGPL-3.0",
    "author": "Johannes Wilm",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./state_plugins": {
            "types": "./dist/state_plugins/index.d.ts",
            "default": "./dist/state_plugins/index.js"
        },
        "./state_plugins/*": {
            "types": "./dist/state_plugins/*.d.ts",
            "default": "./dist/state_plugins/*.js"
        },
        "./menus": {
            "types": "./dist/menus/index.d.ts",
            "default": "./dist/menus/index.js"
        },
        "./menus/*": {
            "types": "./dist/menus/*.d.ts",
            "default": "./dist/menus/*.js"
        },
        "./dialogs": {
            "types": "./dist/dialogs/index.d.ts",
            "default": "./dist/dialogs/index.js"
        },
        "./dialogs/*": {
            "types": "./dist/dialogs/*.d.ts",
            "default": "./dist/dialogs/*.js"
        },
        "./keymap": {
            "types": "./dist/keymap.d.ts",
            "default": "./dist/keymap.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "css/",
        "dist/",
        "src/",
        "static/",
        "locale/*/messages.json",
        "LICENSE",
        "README.md",
        "logo.svg"
    ],
    "scripts": {
        "build": "tsc",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js && node test/no-collab-save-merge.js && node test/no-collab-save-scheduling.js && node test/copy-serializer.js && node test/comment-store.js && node test/import-comments.js && node test/contributor-dialog.js && node test/paste-slice.js && node test/tracked-changes.js && node test/host-file-menu-items.js",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium",
        "deploy-pages": "./scripts/deploy-pages.sh",
        "install-hooks": "husky",
        "demo": "echo 'Open demo/editor/index.html or run: npx http-server .pages-build -p 8080 -c-1'",
        "testserver": "node scripts/serve-demo.js"
    },
    "dependencies": {
        "@fiduswriter/bibliography-manager": "^0.1.35",
        "@fiduswriter/document": "^0.3.24",
        "@fiduswriter/image-manager": "^0.1.28",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "cropperjs": "^1.6.3",
        "diff": "^5.2.2",
        "diff-dom": "^5.2.1",
        "downloadjs": "^1.4.7",
        "fast-deep-equal": "^3.1.3",
        "fast-xml-parser": "^4.5.7",
        "fastdom": "^1.0.12",
        "fix-utf8": "^2.0.1",
        "fwtoolkit": "^0.2.26",
        "jszip": "^3.10.2",
        "lingotweaker-wasm": "^0.2.6",
        "mathml-to-latex": "^1.8.0",
        "mathml2omml": "^0.5.0",
        "orderedmap": "^2.1.1",
        "prosemirror-changeset": "^2.4.4",
        "prosemirror-collab": "^1.3.1",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-dropcursor": "^1.8.4",
        "prosemirror-example-setup": "^1.2.3",
        "prosemirror-gapcursor": "^1.4.1",
        "prosemirror-history": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-menu": "^1.3.2",
        "prosemirror-model": "^1.25.12",
        "prosemirror-schema-basic": "^1.2.5",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-suggestions": "^0.2.0",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.2",
        "prosemirror-view": "^1.42.6",
        "rfc6902": "^5.3.0",
        "sortablejs": "^1.15.7",
        "w3c-keyname": "2.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/source-sans-pro": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "esbuild": "^0.25.12",
        "eslint": "^10.12.0",
        "events": "^3.3.0",
        "gettext-parser": "^9.1.1",
        "globals": "^15.15.0",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lingotweaker-data-de": "^0.2.6",
        "lingotweaker-data-en": "^0.2.6",
        "lingotweaker-data-es": "^0.2.6",
        "lingotweaker-data-fr": "^0.2.6",
        "lingotweaker-data-it": "^0.2.6",
        "lingotweaker-data-pt": "^0.2.6",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0"
    },
    "fiduswriter": {
        "css": {
            "fwtoolkit": [
                "colors.css",
                "forms.css",
                "text.css",
                "buttons.css",
                "dialog.css",
                "loader.css",
                "alerts.css",
                "pulldown.css",
                "data_table.css",
                "content_menu.css",
                "dialog_table.css",
                "common.css",
                "inline_tools.css",
                "add_remove_dialog.css"
            ],
            "own": {
                "additive": [
                    "colors.css"
                ],
                "component": [
                    "editor.css",
                    "document.css",
                    "access_rights_dialog.css",
                    "carets.css",
                    "chat.css",
                    "citation_dialog.css",
                    "contributors.css",
                    "dot_menu.css",
                    "e2ee.css",
                    "footnotes.css",
                    "margin_boxes.css",
                    "merge.css",
                    "review.css",
                    "table.css",
                    "tags.css",
                    "tracking.css"
                ]
            }
        }
    },
    "lint-staged": {
        "*.{ts,js,mjs,css,md,json,html}": [
            "prettier --write"
        ],
        "*.{ts,js,mjs}": [
            "eslint --fix",
            "sh -c 'npm run typecheck'"
        ]
    }
}
